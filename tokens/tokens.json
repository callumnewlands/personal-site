    "font": {
        "family": {
            "heading": {
                "$type": "fontFamily",
                "$value": ["Bricolage Grotesque", "sans-serif"],
                "$description": "Headings and numbers. 800, and 600 for the callout."
            },
            "body": {
                "$type": "fontFamily",
                "$value": ["Commissioner", "system-ui", "sans-serif"],
                "$description": "Everything else. 400, 500, 600 (never 700)."
            },
            "code": {
                "$type": "fontFamily",
                "$value": ["Red Hat Mono", "ui-monospace", "monospace"],
                "$description": "Real code only. Weight 500. font-variant-ligatures: none."
            },
            "logo": {
                "$type": "fontFamily",
                "$value": ["Quicksand"],
                "$description": "Logo name only, outlined in the SVG. Don't load it as a web font."
            }
        },
        "weight": {
            "regular": {
                "$type": "fontWeight",
                "$value": 400
            },
            "medium": {
                "$type": "fontWeight",
                "$value": 500
            },
            "bold": {
                "$type": "fontWeight",
                "$value": 600
            },
            "heading": {
                "$type": "fontWeight",
                "$value": 800
            }
        },
        "size": {
            "display": {
                "$type": "dimension",
                "$value": "clamp(2.5rem, 1.6rem + 4vw, 5.5rem)",
                "$description": "h1, 40 to 88px. Line height 1, letter-spacing -0.02em."
            },
            "section-title": {
                "$type": "dimension",
                "$value": "2.75rem",
                "$description": "44px; 2.5rem on phones."
            },
            "section-title-phone": {
                "$type": "dimension",
                "$value": "2.5rem"
            },
            "chapter-title": {
                "$type": "dimension",
                "$value": "clamp(1.875rem, 1.4rem + 1.5vw, 2.5rem)",
                "$description": "30 to 40px; 2.125rem on phones."
            },
            "chapter-title-phone": {
                "$type": "dimension",
                "$value": "2.125rem"
            },
            "panel-title": {
                "$type": "dimension",
                "$value": "clamp(2.25rem, 1.6rem + 2vw, 3.25rem)",
                "$description": "36 to 52px; 2.5rem on phones."
            },
            "panel-title-phone": {
                "$type": "dimension",
                "$value": "2.5rem"
            },
            "callout": {
                "$type": "dimension",
                "$value": "clamp(1.625rem, 1.2rem + 1.4vw, 2.25rem)",
                "$description": "Headline result only; 1.375rem on phones. Bricolage 600."
            },
            "callout-phone": {
                "$type": "dimension",
                "$value": "1.375rem"
            },
            "stat": {
                "$type": "dimension",
                "$value": "clamp(2.5rem, 1.9rem + 2vw, 3.5rem)",
                "$description": "Sourced numbers only. Line height 0.95."
            },
            "lead": {
                "$type": "dimension",
                "$value": "clamp(1.375rem, 1.2rem + 0.6vw, 1.625rem)",
                "$description": "22 to 26px. Line height 1.45."
            },
            "body": {
                "$type": "dimension",
                "$value": "1.125rem",
                "$description": "18px. Line height 1.6, max 68ch."
            },
            "small": {
                "$type": "dimension",
                "$value": "1.0625rem",
                "$description": "17px desktop, 1rem phones. Line height 1.55."
            },
            "small-phone": {
                "$type": "dimension",
                "$value": "1rem"
            },
            "caption": {
                "$type": "dimension",
                "$value": "0.9375rem",
                "$description": "15px. The floor for reading text. Line height 1.5."
            },
            "input": {
                "$type": "dimension",
                "$value": "1.0625rem",
                "$description": "17px. Never under 1rem."
            },
            "button": {
                "$type": "dimension",
                "$value": "1.1875rem",
                "$description": "19px, weight 600. Raised and mint buttons at every width."
            },
            "code": {
                "$type": "dimension",
                "$value": "1rem",
                "$description": "Code blocks 1rem; 0.875rem on phones; 1.0625rem for the larger homepage snippet."
            },
            "quote": {
                "$type": "dimension",
                "$value": "clamp(1.625rem, 1.2rem + 1.4vw, 2.375rem)",
                "$description": "26 to 38px. Bricolage 800, lh 1.2, max 30ch."
            },
            "card-title": {
                "$type": "dimension",
                "$value": "1.3125rem",
                "$description": "21px work card title."
            },
            "card-title-wide": {
                "$type": "dimension",
                "$value": "1.5rem",
                "$description": "24px, the wide card."
            },
            "timeline-title": {
                "$type": "dimension",
                "$value": "1.75rem"
            },
            "timeline-date": {
                "$type": "dimension",
                "$value": "1.25rem",
                "$description": "Bricolage 800 in viridian."
            },
            "marker-number": {
                "$type": "dimension",
                "$value": "0.9375rem",
                "$description": "Commissioner 600 in a 30px circle; 0.875rem in 26px on phones."
            }
        }
