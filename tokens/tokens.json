        },
        "lift": {
            "$type": "shadow",
            "$value": "0 10px 24px rgba(27,43,40,0.10)",
            "$description": "Tilted stat tiles."
        },
        "photo": {
            "$type": "shadow",
            "$value": "0 16px 34px rgba(27,43,40,0.22)",
            "$description": "The fan, polaroids."
        },
        "float": {
            "$type": "shadow",
            "$value": "0 24px 48px rgba(10,20,18,0.30)",
            "$description": "Product fragments poking out of a panel."
        },
        "button": {
            "$type": "shadow",
            "$value": "0 10px 24px rgba(27,43,40,0.14)",
            "$description": "The raised button."
        },
        "button-hover": {
            "$type": "shadow",
            "$value": "0 14px 28px rgba(27,43,40,0.18)",
            "$description": "The raised button on hover, with the 2px lift."
        },
        "button-pressed": {
            "$type": "shadow",
            "$value": "0 6px 14px rgba(27,43,40,0.14)",
            "$description": "The raised button when pressed, with no lift."
        },
        "card-hover": {
            "$type": "shadow",
            "$value": "0 2px 4px rgba(27,43,40,0.05), 0 8px 20px rgba(27,43,40,0.08)",
            "$description": "Work card hover, with the line-strong border."
