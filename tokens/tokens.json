            "$value": "2px"
        },
        "ring-color": {
            "$type": "color",
            "$value": "#067a7e",
            "$description": "Mint (#a2dccf) on dark backgrounds."
        }
    },
    "size": {
        "target-min": {
            "$type": "dimension",
            "$value": "44px"
        },
        "button-primary": {
            "$type": "dimension",
            "$value": "56px",
            "$description": "Raised primary height."
        },
        "button-secondary": {
            "$type": "dimension",
            "$value": "48px"
        },
        "field": {
            "$type": "dimension",
            "$value": "52px"
        },
        "logo-mark-nav": {
            "$type": "dimension",
            "$value": "48px",
            "$description": "Never under 32px."
        },
        "logo-mark-phone": {
            "$type": "dimension",
            "$value": "38px"
        }
