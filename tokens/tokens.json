        "card": {
            "$type": "dimension",
            "$value": "1.5rem"
        },
        "list-card": {
            "$type": "dimension",
            "$value": "1rem 1.25rem"
        },
        "tile": {
            "$type": "dimension",
            "$value": "1rem 1.5rem"
        },
        "fragment": {
            "$type": "dimension",
