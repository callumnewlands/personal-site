{
    "color": {
        "primary": {
            "$type": "color",
            "$value": "#067a7e",
            "$description": "Viridian. Main button, links, step numbers, logo mark. No body text on the band (4.35:1)."
        },
        "primary-hover": {
            "$type": "color",
            "$value": "#04585b",
            "$description": "Viridian dark. Hover and pressed."
        },
        "accent": {
            "$type": "color",
            "$value": "#a2dccf",
            "$description": "Mid mint. One results tile, review panel, button and logo on dark. Use sparingly."
        },
        "accent-hover": {
            "$type": "color",
            "$value": "#92c6ba",
            "$description": "Mint dark. Hover for the button on dark."
        },
        "on-accent": {
            "$type": "color",
            "$value": "#15231f",
            "$description": "Text on mint."
        },
        "on-dark": {
            "$type": "color",
            "$value": "#ffffff",
            "$description": "Text on primary, dark blocks and the footer."
        },
        "dark-block": {
            "$type": "color",
            "$value": "#2f5a4a",
            "$description": "Dark blocks: About header band, a results tile, step numbers."
        },
        "footer": {
            "$type": "color",
            "$value": "#22332f",
            "$description": "Footer."
        },
        "footer-text-subtle": {
            "$type": "color",
            "$value": "#9fb8b2",
            "$description": "Small text on the footer (6.3:1)."
        },
        "fragment": {
            "$type": "color",
            "$value": "#16221f",
            "$description": "Product fragments only."
        },
        "fragment-row": {
            "$type": "color",
            "$value": "#1d2c29",
            "$description": "Rows inside fragments."
        },
        "fragment-code": {
            "$type": "color",
            "$value": "#0f1816",
            "$description": "Code inside fragments."
        },
        "band": {
            "$type": "color",
            "$value": "#e6eeeb",
            "$description": "Tinted sections."
        },
        "page": {
            "$type": "color",
            "$value": "#fafcfc",
            "$description": "Default background."
        },
        "surface": {
            "$type": "color",
            "$value": "#ffffff",
            "$description": "Cards, work cards, form card, option tiles. Never a full-width band."
        },
        "ink": {
            "$type": "color",
            "$value": "#1b2b28",
            "$description": "Text on light surfaces."
        },
        "muted": {
            "$type": "color",
            "$value": "#3a4b47",
            "$description": "Secondary text, leads, sublines."
        },
        "subtle": {
            "$type": "color",
            "$value": "#52625e",
            "$description": "Labels, captions, metadata. 15px minimum."
        },
        "line": {
            "$type": "color",
            "$value": "#dfe7e5",
            "$description": "Hairlines: card borders, list and timeline rules."
        },
        "line-card": {
            "$type": "color",
            "$value": "#e3ebe8",
            "$description": "Work card border."
        },
        "line-control": {
            "$type": "color",
            "$value": "#9fb8b2",
            "$description": "Outlined button border."
        },
        "line-strong": {
            "$type": "color",
            "$value": "#c9d7d3",
            "$description": "Form tile borders, the rule before More work."
        },
        "error": {
            "$type": "color",
            "$value": "#b3261e",
            "$description": "Form errors only, with an icon and a message."
        },
        "status": {
            "pass": {
                "$type": "color",
                "$value": "#3fae74",
                "$description": "Inside fragments only."
            },
            "waiting": {
                "$type": "color",
                "$value": "#d9a93a",
                "$description": "Inside fragments only."
            },
            "high-text": {
                "$type": "color",
                "$value": "#f3c9cf",
                "$description": "Inside fragments only."
            },
            "high-bg": {
                "$type": "color",
                "$value": "#3a1d22",
                "$description": "Inside fragments only."
            },
            "diff-add-text": {
                "$type": "color",
                "$value": "#bfe9cf",
                "$description": "Diff added line."
            },
            "diff-add-bg": {
                "$type": "color",
                "$value": "#183326",
                "$description": "Diff added line."
            },
            "medium-text": {
                "$type": "color",
                "$value": "#f2d98d"
            },
            "medium-bg": {
                "$type": "color",
                "$value": "#3d3418",
                "$description": "8.9:1."
            }
        },
        "line-input": {
            "$type": "color",
            "$value": "#7b958f",
            "$description": "Input and textarea borders. 3.2:1 on white (3:1 rule for controls)."
        },
        "selected": {
            "$type": "color",
            "$value": "#f0f7f5",
            "$description": "Fill of a selected option tile."
        },
        "tag-on-image": {
            "$type": "color",
            "$value": "rgba(22,34,31,0.7)",
            "$description": "Tag fill on screenshots: the fragment colour at 70%, so white text stays at 4.5:1 over light screenshots. With white text and a 1px white border at 80%."
        },
        "fragment-text": {
            "$type": "color",
            "$value": "#e6efec"
        },
        "fragment-text-subtle": {
            "$type": "color",
            "$value": "#9fb8b2"
        },
        "fragment-code-text": {
            "$type": "color",
            "$value": "#c9d8d4"
        },
        "fragment-box-border": {
            "$type": "color",
            "$value": "#3f5652",
            "$description": "2px."
        },
        "fragment-ticket-border": {
            "$type": "color",
            "$value": "#33473f"
        },
        "fragment-connector": {
            "$type": "color",
            "$value": "#5d7671",
            "$description": "Dashed 2px."
        }
