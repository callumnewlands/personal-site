{
    "name": "personal-site",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.15.0",
    "scripts": {
        "postinstall": "pnpm tokens",
        "predev": "pnpm tokens && node --env-file-if-exists=.env.local scripts/build-seo-assets.mjs",
        "dev": "next dev -p 3002",
        "build": "next build",
        "prebuild": "pnpm tokens && node --env-file-if-exists=.env.local scripts/build-seo-assets.mjs",
        "postbuild": "node --env-file-if-exists=.env.local scripts/build-sitemap.mjs",
        "start": "next start",
        "tokens": "style-dictionary build --config tokens/config.json",
        "content-schema": "node scripts/build-content-schema.mjs && prettier --write content/projects/schema.json",
        "test": "playwright test",
        "test:unit": "vitest run",
        "lint": "oxlint --deny-warnings",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lhci": "pnpm dlx @lhci/cli@0.15.1 autorun",
        "guidelines": "node docs/brand-guidelines-source/build.mjs"
    },
    "dependencies": {
        "image-size": "^2.0.4",
        "marked": "^18.1.3",
        "next": "^16.4.5",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-vertical-timeline-component": "^4.0.0",
        "sass": "^1.107.1",
        "yaml": "^2.9.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@babel/parser": "^8.1.0",
        "@playwright/test": "^1.64.1",
        "@types/node": "^24",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/react-vertical-timeline-component": "^3.3.6",
        "oxlint": "^1.91.0",
        "prettier": "^3.9.10",
        "sharp": "^0.35.5",
        "style-dictionary": "^5.8.0",
        "typescript": "^5.9.3",
        "vitest": "^5.1.0"
    }
}
