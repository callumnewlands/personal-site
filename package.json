{
    "name": "personal-site",
    "version": "1.0.0",
    "private": true,
    "packageManager": "pnpm@12.15.0",
    "scripts": {
        "predev": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-seo-assets.mjs",
        "dev": "next dev -p 3002",
        "build": "next build",
        "prebuild": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-seo-assets.mjs",
        "postbuild": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-sitemap.mjs",
        "start": "next start",
        "test": "playwright test",
        "test:unit": "vitest run",
        "lint": "oxlint --deny-warnings",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lhci": "pnpm dlx @lhci/cli@0.15.1 autorun",
        "guidelines": "node docs/brand-guidelines-source/build.mjs"
    },
    "dependencies": {
        "image-size": "^2.0.4",
        "marked": "^18.1.1",
        "next": "^16.4.3",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-vertical-timeline-component": "^4.0.0",
        "sass": "^1.106.1"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@playwright/test": "^1.64.1",
        "@types/node": "^24",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/react-vertical-timeline-component": "^3.3.6",
        "oxlint": "^1.89.0",
        "prettier": "^3.9.10",
        "sharp": "^0.35.5",
        "typescript": "^5.9.3",
        "vitest": "^5.0.5"
    }
}
