{
    "trailingComma": "none",
    "tabWidth": 4,
    "printWidth": 120,
    "overrides": [
        {
            "files": ["*.css", "*.scss", "*.sass", "*.yml", "*.yaml"],
            "options": {
                "tabWidth": 2
            }
        }
    ],
    "semi": true,
    "singleQuote": false,
